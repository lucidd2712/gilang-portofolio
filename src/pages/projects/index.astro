---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHead from "../../components/ui/SectionHead.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection } from "astro:content";

const all = await getCollection("projects");
const items = all.sort((a,b) => (b.data.date?.valueOf?.() ?? 0) - (a.data.date?.valueOf?.() ?? 0));
---
<BaseLayout title="Projects | Portfolio" description="Daftar project">
  <section class="section">
    <Container>
      <SectionHead title="All Projects" subtitle="Semua project yang kamu dokumentasikan." />
      <div class="grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
        {items.map((p) => (
          <Card>
            <div style="font-weight:850">{p.data.title}</div>
            <div class="muted" style="font-size:13px; margin-top:6px">{p.data.description}</div>
            <div style="height:12px"></div>
            <Button href={`/projects/${p.slug}`} variant="primary">Buka detail</Button>
          </Card>
        ))}
      </div>
      <style>
        @media (max-width: 920px){
          .grid[style*="repeat(2"]{ grid-template-columns: 1fr !important; }
        }
      </style>
    </Container>
  </section>
</BaseLayout>
