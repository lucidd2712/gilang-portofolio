  brand: "Portofolio",
  heroKicker: "Halo, Saya Gilang",
  heroTitleA: "Data Science",
  heroTitleB: "AI/ML Engineer",
  heroDesc:
    "Mahasiswa Sistem Informasi dengan minat kuat di Project Management, Business/System Analysis, Data Science & Analytics, AI, dan Software Engineering. Fokus membuat produk digital yang rapi, terukur, dan siap dipakai.",
  ctaPrimary: { label: "Lihat Karya Saya", href: "#portofolio" },
  ctaSecondary: { label: "Download CV", href: "/cv.pdf" }, // ganti path file CV
  socials: {
    github: "https://github.com/your-username",
    linkedin: "https://www.linkedin.com/in/your-username",
    email: "mailto:you@email.com",
