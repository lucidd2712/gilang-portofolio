---
type Variant = "primary" | "secondary" | "ghost";
const {
  href,
  variant = "secondary",
  class: className = "",
  target,
  rel,
} = Astro.props as {
  href?: string;
  variant?: Variant;
  class?: string;
  target?: string;
  rel?: string;
};

const variantClass =
  variant === "primary" ? "btn btn-primary" :
  variant === "ghost" ? "btn btn-ghost" :
  "btn btn-secondary";

const safeRel = target === "_blank"
  ? (rel ?? "noreferrer noopener")
  : rel;
---
{href ? (
  <a class={`${variantClass} ${className}`} href={href} target={target} rel={safeRel}>
    <slot />
  </a>
) : (
  <button class={`${variantClass} ${className}`} type="button">
    <slot />
  </button>
)}
