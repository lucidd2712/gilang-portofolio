---
import Container from "../ui/Container.astro";
import SectionHead from "../ui/SectionHead.astro";
import Card from "../ui/Card.astro";
import { site } from "../../config/site";
---
<section id="about" class="section">
  <Container>
    <SectionHead title={site.about.title} subtitle="Sedikit konteks supaya orang cepat paham value kamu." />
    <div class="grid" style="grid-template-columns: 1.2fr .8fr;">
      <Card>
        {site.about.paragraphs.map((p) => <p style="margin:0 0 10px 0" class="muted">{p}</p>)}
      </Card>

      <Card>
        <div class="muted" style="font-size:13px">Kamu bisa copy ini jadi “elevator pitch”</div>
        <div style="height:10px"></div>
        <div style="font-weight:750; font-size:16px">
          “{site.headline} yang fokus pada delivery: rapi, terukur, dan maintainable.”
        </div>
        <div style="height:12px"></div>
        <div class="muted" style="font-size:13px">
          Kalau kamu mau, nanti kamu bisa tambahkan “highlight 3 project terbaik” di bawahnya.
        </div>
      </Card>
    </div>

    <style>
      @media (max-width: 920px){
        .grid[style*="1.2fr"]{ grid-template-columns: 1fr !important; }
      }
    </style>
  </Container>
</section>
