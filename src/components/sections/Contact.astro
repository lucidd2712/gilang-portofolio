---
import Container from "../ui/Container.astro";
import SectionHead from "../ui/SectionHead.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import { site } from "../../config/site";
---
<section id="contact" class="section">
  <Container>
    <SectionHead title={site.contact.title} subtitle={site.contact.subtitle} />

    <div class="grid" style="grid-template-columns: 1fr 1fr;">
      <Card>
        <div style="font-weight:850; font-size:16px">Email</div>
        <div class="muted" style="margin-top:8px">{site.email}</div>
        <div style="height:12px"></div>
        <Button href={`mailto:${site.email}`} variant="primary">Kirim email</Button>
      </Card>

      <Card>
        <div style="font-weight:850; font-size:16px">LinkedIn</div>
        <div class="muted" style="margin-top:8px">Untuk networking dan profesional profile.</div>
        <div style="height:12px"></div>
        <Button href={site.socials.linkedin} target="_blank" variant="secondary">Buka LinkedIn</Button>
      </Card>
    </div>

    <style>
      @media (max-width: 920px){
        .grid[style*="1fr 1fr"]{ grid-template-columns: 1fr !important; }
      }
    </style>
  </Container>
</section>
